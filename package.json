{
  "name": "fjaleza",
  "private": true,
  "version": "1.0.0",
  "description": "Fjalëza: the daily Albanian word game. Static site, no backend.",
  "type": "module",
  "scripts": {
    "predev": "node scripts/compile-words.mjs",
    "dev": "vite",
    "prebuild": "node scripts/compile-words.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pretest": "node scripts/compile-words.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "words:build": "node scripts/build-word-lists.mjs",
    "words:compile": "node scripts/compile-words.mjs",
    "assets": "node scripts/generate-assets.mjs"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "author": "Ezan Nebija (https://ezannebija.dev/)"
}
