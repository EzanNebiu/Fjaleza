import { describe, it } from 'vitest';
import { tokenizeAlbanian } from '../core/tokenizer';
import { getAllowedWords, isAllowedWord } from '../data/wordRepository';
import { VALID_ALLOWED_WORDS } from '../data/words';

describe('Test many common Albanian words', () => {
  it('should show which common words are missing', () => {
    const validWordsSet = getAllowedWords();
    
    // Common Albanian words people would try
    const commonWords = [
      'LIBËR', 'KLASË', 'DHOMËN', 'GJUHËN', 'RRUGËN', 'SHQIPE', 'LLAMBA',
      'SHTËPI', 'FJALË', 'MIRË', 'KOHË', 'DITË', 'NATË', 'PUNË', 'JETË',
      'VENDI', 'TOKË', 'UJKU', 'MIKU', 'BORË', 'MALE', 'LULE', 'PEMË',
      'PORTË', 'DRITË', 'DEGË', 'GJATË', 'KUQE', 'BARDHË', 'ZEZË', 'GJITHË',
      'PESHK', 'MISHË', 'KËMBË', 'DORË', 'KOKË', 'SYTË', 'VESH', 'HUNDË',
      'GOJË', 'ZEMËR', 'BUKUR', 'BUTË', 'FORTË', 'MADH', 'VOGËL', 'NËNË',
      'BABA', 'MAMA', 'MOTËR', 'VËLLA', 'DJALI', 'VAJZA', 'BURRI', 'GRUA',
      'SHQIP', 'DHOMA', 'RRUGA', 'GJUHA', 'LLAMBË', 'SHKOLLË', 'LIBRA',
    ];
    
    console.log('\n=== Testing Common Albanian Words ===');
    console.log(`Total words in dictionary: ${VALID_ALLOWED_WORDS.length}`);
    console.log(`ValidWordsSet size: ${validWordsSet.size}\n`);
    
    const working: string[] = [];
    const notWorking: string[] = [];
    
    commonWords.forEach(word => {
      const tokens = tokenizeAlbanian(word, validWordsSet);
      const isValid = isAllowedWord(word);
      
      if (isValid && tokens.length === 5) {
        working.push(`✅ ${word} (${word.length} chars) -> ${tokens.length} tokens`);
      } else {
        notWorking.push(`❌ ${word} (${word.length} chars) -> ${tokens.length} tokens - ${isValid ? 'in list' : 'NOT in list'}`);
      }
    });
    
    console.log('WORKING WORDS:');
    working.forEach(w => console.log(`  ${w}`));
    
    console.log('\nNOT WORKING WORDS:');
    notWorking.forEach(w => console.log(`  ${w}`));
    
    console.log(`\nSummary: ${working.length}/${commonWords.length} common words working`);
  });
});
