import { describe, it } from 'vitest';
import { tokenizeAlbanian } from '../core/tokenizer';
import { getAllowedWords, isAllowedWord } from '../data/wordRepository';

describe('Test 6-letter words with digraphs', () => {
  it('should validate 6-letter words with 1 digraph = 5 tokens', () => {
    const validWordsSet = getAllowedWords();
    
    const test6LetterWords = [
      'DHOMËN', // DH-O-M-Ë-N = 5 tokens
      'GJUHËN', // GJ-U-H-Ë-N = 5 tokens
      'RRUGËN', // RR-U-G-Ë-N = 5 tokens
      'SHQIPE', // SH-Q-I-P-E = 5 tokens
      'SHTËPI', // SH-T-Ë-P-I = 5 tokens (wait this might be 6 chars)
      'LLAMBA', // LL-A-M-B-A = 5 tokens
    ];
    
    console.log('\n=== Testing 6-letter words with 1 digraph ===');
    test6LetterWords.forEach(word => {
      const tokens = tokenizeAlbanian(word, validWordsSet);
      const isValid = isAllowedWord(word);
      const inSet = validWordsSet.has(word);
      
      console.log(`\nWord: ${word} (${word.length} chars)`);
      console.log(`  Tokens: [${tokens.join(', ')}] (${tokens.length} tokens)`);
      console.log(`  isAllowedWord(): ${isValid}`);
      console.log(`  In validWordsSet: ${inSet}`);
      console.log(`  ${tokens.length === 5 && isValid ? '✅' : '❌'}`);
    });
  });
});
